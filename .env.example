# JARVIS Environment Variables & Secrets
# Note: Tokens and OAuth credentials are saved into the secure OS Keyring.
# Optional API Keys if you choose cloud models:

# Free Gemini API key (optional - https://aistudio.google.com/)
GEMINI_API_KEY=

# Groq Cloud API key (optional - https://console.groq.com/)
GROQ_API_KEY=

# Anthropic Claude API key (optional)
ANTHROPIC_API_KEY=

# OpenAI API key (optional)
OPENAI_API_KEY=

# ElevenLabs API key (optional)
ELEVENLABS_API_KEY=

# Weather & News (defaults to free open endpoints wttr.in & RSS, no key required)
NEWS_API_KEY=
